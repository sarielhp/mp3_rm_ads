// Bubblewrap Development Sandbox Configuration (.bws/config.jsonc)
{
  "profiles": [
    "git",
    "go",
    "docker",
    "abs",
    "secure-agent"
  ],
  "features": {
    "enable_dbus": true
  },
  "env": {
    "GOPATH": "@@HOME@@/.go"
  },
  "path": [
    "@@HOME@@/.go/bin",
    "@@HOME@@/.local/bin",
    "@@HOME@@/bin"
  ],
  "pass_env": [
    "GEMINI_API_KEY",
    "OPENROUTER_API_KEY",
    "WHISPER_URL",
    "ABS_URL",
    "AUDIOBOOKSHELF_URL",
    "PODFETCH_URL"
  ],
  "binds_rw": [
    [
      "~/.gemini",
      "@@HOME@@/.gemini"
    ],
    [
      "~/.cache/go-build",
      "@@HOME@@/.cache/go-build"
    ],
    [
      "~/.config/go",
      "@@HOME@@/.config/go"
    ],
    [
      "~/.go",
      "@@HOME@@/.go"
    ],
    [
      "~/.opencode",
      "@@HOME@@/.opencode"
    ],
    [
      "~/.config/opencode",
      "@@HOME@@/.config/opencode"
    ],
    [
      "~/.config/opencode-switcher",
      "@@HOME@@/.config/opencode-switcher"
    ],
    [
      "~/.local/share/opencode",
      "@@HOME@@/.local/share/opencode"
    ],
    [
      "~/.local/state/opencode",
      "@@HOME@@/.local/state/opencode"
    ],
    [
      "~/.cache/opencode",
      "@@HOME@@/.cache/opencode"
    ],
    [
      "~/.config/abs",
      "@@HOME@@/.config/abs"
    ],
    [
      "~/.cache/abs",
      "@@HOME@@/.cache/abs"
    ],
    [
      "/home/media",
      "/home/media"
    ],
    [
      "/home/media",
      "/media"
    ],
    [
      "/var/run/docker.sock",
      "/var/run/docker.sock"
    ]
  ],
  "binds_ro": [
    [
      "~/bin",
      "@@HOME@@/bin"
    ],
    [
      "~/.local",
      "@@HOME@@/.local"
    ],
    [
      "~/.gitconfig",
      "@@HOME@@/.gitconfig"
    ]
  ]
}
