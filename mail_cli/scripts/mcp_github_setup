#!/usr/bin/env ruby
# frozen_string_literal: true

require 'open3'
require 'fileutils'

# ==============================================================================
# mcp_github_setup.rb
# Sets up GitHub MCP token authentication for the current project repository.
# Usable across any git repository with a GitHub remote setup.
# ==============================================================================

def run_cmd(*cmd)
  stdout, stderr, status = Open3.capture3(*cmd)
  [stdout.strip, stderr.strip, status.success?]
rescue Errno::ENOENT
  ['', 'Command not found', false]
end

# 1. Verify inside git repo
stdout, _, success = run_cmd('git', 'rev-parse', '--is-inside-work-tree')
unless success && stdout == 'true'
  warn 'Error: Current directory is not inside a Git repository.'
  exit 1
end

repo_root, _, _ = run_cmd('git', 'rev-parse', '--show-toplevel')
Dir.chdir(repo_root)

# 2. Check for GitHub CLI (gh)
_, _, gh_installed = run_cmd('which', 'gh')
unless gh_installed
  warn "Error: 'gh' (GitHub CLI) is not installed or not in PATH."
  warn "Please install GitHub CLI from https://cli.github.com/ and run 'gh auth login'."
  exit 1
end

# 3. Retrieve GitHub repository name
repo_name, _, success = run_cmd('gh', 'repo', 'view', '--json', 'nameWithOwner', '-q', '.nameWithOwner')
unless success && !repo_name.empty?
  remote_url, _, _ = run_cmd('git', 'config', '--get', 'remote.origin.url')
  repo_name = remote_url.empty? ? File.basename(repo_root) : remote_url
end

# 4. Retrieve authenticated GitHub token via gh
token, _, success = run_cmd('gh', 'auth', 'token')
if !success || token.empty?
  warn "Error: Failed to obtain GitHub token from 'gh'."
  warn "Please authenticate by running: gh auth login"
  exit 1
end

# 5. Ensure .gitignore includes .env
gitignore_path = File.join(repo_root, '.gitignore')
if File.exist?(gitignore_path)
  lines = File.readlines(gitignore_path, chomp: true)
  if lines.any? { |l| l.strip.match?(/\A\.env(\*|\b)/) }
    puts '✓ .gitignore already ignores .env'
  else
    File.open(gitignore_path, 'a') do |f|
      f.puts '' unless lines.empty? || lines.last.empty?
      f.puts '# Environment & Secrets'
      f.puts '.env'
      f.puts '.env.local'
    end
    puts '✓ Added .env and .env.local to .gitignore'
  end
else
  File.write(gitignore_path, "# Environment & Secrets\n.env\n.env.local\n")
  puts '✓ Created .gitignore and added .env'
end

# 6. Check if .env is already tracked by git
_, _, tracked = run_cmd('git', 'ls-files', '--error-unmatch', '.env')
if tracked
  warn '⚠️  WARNING: .env is currently tracked in git!'
  warn "Run 'git rm --cached .env' and commit to prevent leaking secrets."
end

# 7. Update or create .env file
env_path = File.join(repo_root, '.env')
env_lines = File.exist?(env_path) ? File.readlines(env_path, chomp: true) : []

keys_to_set = {
  'GITHUB_PERSONAL_ACCESS_TOKEN' => token,
  'GITHUB_TOKEN' => token
}

updated_keys = {}

new_lines = env_lines.map do |line|
  key = line.split('=', 2).first&.strip
  if keys_to_set.key?(key)
    updated_keys[key] = true
    "#{key}=\"#{keys_to_set[key]}\""
  else
    line
  end
end

keys_to_set.each do |key, val|
  new_lines << "#{key}=\"#{val}\"" unless updated_keys[key]
end

File.write(env_path, "#{new_lines.join("\n")}\n")
File.chmod(0600, env_path)

# 8. Print summary
puts <<~SUMMARY

  =================================================================
   GitHub MCP Setup Complete (Ruby)
  =================================================================
   Target Repository : #{repo_name}
   Configuration File: #{env_path}
   Permissions       : 0600 (owner read/write only)

  What was done:
   1. Retrieved active GitHub authentication token from 'gh'.
   2. Saved GITHUB_PERSONAL_ACCESS_TOKEN and GITHUB_TOKEN to .env.
   3. Verified that .env is safely excluded in .gitignore.

  AI Agent Compatibility:
   • OpenCode: Automatically loads .env on startup.
   • Antigravity-CLI: Global GitHub MCP server will pick up credentials
     from your environment or .env when running in this workspace.
  =================================================================
SUMMARY
