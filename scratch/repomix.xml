<file path="tools/install">
#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

BINARY="abs"
INSTALL_DIR="${HOME}/bin"

if ! git diff --quiet HEAD; then
  git add -A
  git commit -m "chore: auto-commit before install" > /dev/null
fi

remote="$(git rev-parse "@{upstream}" 2>/dev/null || true)"
if [ -n "$remote" ]; then
  local_sha=$(git rev-parse HEAD)
  remote_sha=$(git rev-parse "@{upstream}" 2>/dev/null || echo "")

  if [ "$local_sha" != "$remote_sha" ]; then
    behind=$(git rev-list --count HEAD.."@{upstream}" 2>/dev/null || echo 0)
    ahead=$(git rev-list --count "@{upstream}"..HEAD 2>/dev/null || echo 0)
    if [ "$ahead" -gt 0 ]; then
      git push origin HEAD 2>/dev/null
    fi
    if [ "$behind" -gt 0 ]; then
      git pull --ff-only origin HEAD 2>/dev/null
    fi
  fi
fi

go build -o "$BINARY" .

mkdir -p "$INSTALL_DIR"
cp "$BINARY" "$INSTALL_DIR/$BINARY"

echo "Success: installed to $INSTALL_DIR/$BINARY"
</file>

