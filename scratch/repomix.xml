	os.WriteFile(filepath.Join(d, "ep3.cuts.json"), []byte("{}"), 0644)
	latestFiltered2 := filterMP3FilesByPodcastConfig(files, d, PodcastConfig{AdRemoval: AdRemovalLatest})
	if len(latestFiltered2) != 1 || latestFiltered2[0] != f2 {
